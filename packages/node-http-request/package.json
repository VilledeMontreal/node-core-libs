{
  "name": "@villedemontreal/http-request",
  "version": "9.2.0",
  "description": "HTTP utilities - send HTTP requests with proper headers, etc.",
  "main": "dist/src/index.js",
  "typings": "dist/src",
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "start": "npm run test",
    "test": "c8 mocha --require ts-node/register ./src/**/*.test.ts",
    "compile": "tsc --build",
    "show-tsconfig": "tsc --showConfig",
    "show-coverage": "open output/coverage/lcov-report/index.html",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "ncu": "ncu --target minor -x @types/node",
    "ncu-fix": "ncu -u --target minor -x @types/node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/villedemontreal/node-core-libs.git",
    "directory": "packages/node-http-request"
  },
  "homepage": "https://github.com/villedemontreal/node-core-libs",
  "keywords": [
    "montreal",
    "http",
    "https",
    "request",
    "node.js",
    "utils"
  ],
  "author": "Ville de Montréal",
  "license": "MIT",
  "dependencies": {
    "@villedemontreal/general-utils": "6.1.0",
    "@villedemontreal/logger": "8.2.0",
    "app-root-path": "3.1.0",
    "lodash": "4.18.1",
    "superagent": "10.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/chai": "5.2.3",
    "@types/express": "5.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/lodash": "4.17.27",
    "@types/mocha": "10.0.10",
    "@types/sinon": "22.0.2",
    "@types/superagent": "8.1.11",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "express": "5.3.0",
    "fs-extra": "11.4.1",
    "globals": "17.13.0",
    "http-status-codes": "2.3.0",
    "mocha": "11.8.0",
    "nock": "14.0.17",
    "prettier": "3.9.10",
    "sinon": "22.1.0",
    "source-map-support": "0.5.21",
    "superagent-mocker": "0.5.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
